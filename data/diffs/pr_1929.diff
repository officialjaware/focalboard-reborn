+# deploy/
+## docker-compose.yml
+The example docker-compose.yml in this directory will pull the latest image from DockerHub (you can also specify a specific build if necessary). 
+
+## focalboard_sqlite3_config.json
+An example configuration file has been provided as well. If you wish to override defaults, you'll need to make any changes necessary, and then uncomment the following line in `docker-compose.yml`
+
+`- "./focalboard_sqlite3_config.json:/opt/focalboard/config.json/"`
diff --git a/docker/deploy/docker-compose.yml b/docker/deploy/docker-compose.yml
new file mode 100644
index 00000000000..14716a948b9
--- /dev/null
+++ b/docker/deploy/docker-compose.yml
@@ -0,0 +1,22 @@
+version: "3"
+services:
+  focalboard:
+    # images available here: https://hub.docker.com/r/mattermost/focalboard/tags
+    image: mattermost/focalboard:latest
+    container_name: focalboard
+    ports:
+      - 80:8000
+
+    # Uncomment to set any environment variables necessary
+    # environment:
+    #  - VIRTUAL_HOST=focalboard.local
+    #  - VIRTUAL_PORT=8000
+
+    volumes:
+      - focalboard_data:/data
+    # Uncomment and point to your configuration file if you need to override defaults
+    # - "./focalboard_sqlite3_config.json:/opt/focalboard/config.json/"
+
+volumes:
+  focalboard_data:
+
